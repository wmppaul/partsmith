+        if normalized.range(of: repeatTempo, options: .regularExpression) != nil { return true }
+        let words = normalized.split(whereSeparator: { !$0.isLetter }).map(String.init)
         guard !words.isEmpty else { return false }
         let tempo = vocabulary.prefix(16).map { $0.lowercased() }
